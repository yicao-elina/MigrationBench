  langid = {english},
  keywords = {Atomistic models,Computational methods,Nanoparticles},
  file = {/Users/yicao/Zotero/storage/H2HI56Z6/Zeni et al. - 2021 - Data-driven simulation and characterisation of gold nanoparticle melting.pdf}
}

