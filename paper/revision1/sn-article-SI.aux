\@writefile{lot}{\contentsline {table}{\numberline {S1}{\ignorespaces \textbf  {Current uncentred held-out errors.} Energy RMSE in meV atom$^{-1}$ and Cartesian force-component RMSE in meV \r A$^{-1}$, reported as means and sample standard deviations over training seeds 123, 234, and 345. The underlying 24 train/test evaluations are retained in the current-release source table. Because the thermal conditions utilize distinct test compositions, their respective metrics independently characterize model fidelity within each specific data domain.}}{2}{table.1}\protected@file@percent }
\newlabel{tab:current_pointwise}{{S1}{2}{\textbf {Current uncentred held-out errors.} Energy RMSE in meV atom$^{-1}$ and Cartesian force-component RMSE in meV \AA $^{-1}$, reported as means and sample standard deviations over training seeds 123, 234, and 345. The underlying 24 train/test evaluations are retained in the current-release source table. Because the thermal conditions utilize distinct test compositions, their respective metrics independently characterize model fidelity within each specific data domain}{table.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S1}{\ignorespaces \textbf  {Training routes and comparison design.} \textbf  {a,} Mapping from atomic structure through local descriptors and a neural potential to the total energy, with forces given by its negative coordinate gradient. \textbf  {b,} The zero-shot foundation baselines and the four trained conditions, arranged by training route (scratch or fine-tuning) and target-data regime (600~K or MultiT). The 600~K pool matches the MD thermostat temperature; MultiT broadens thermal coverage. Within each regime, the two routes use the same target-data split. Because the thermal regimes utilize distinct dataset scales and test compositions, and the model implementations natively differ in architecture and optimization, this comparative design evaluates the integrated macroscopic performance of the complete training routes. Model identities accompany the numerical results.}}{3}{figure.1}\protected@file@percent }
\newlabel{fig:training_design}{{S1}{3}{\textbf {Training routes and comparison design.} \textbf {a,} Mapping from atomic structure through local descriptors and a neural potential to the total energy, with forces given by its negative coordinate gradient. \textbf {b,} The zero-shot foundation baselines and the four trained conditions, arranged by training route (scratch or fine-tuning) and target-data regime (600~K or MultiT). The 600~K pool matches the MD thermostat temperature; MultiT broadens thermal coverage. Within each regime, the two routes use the same target-data split. Because the thermal regimes utilize distinct dataset scales and test compositions, and the model implementations natively differ in architecture and optimization, this comparative design evaluates the integrated macroscopic performance of the complete training routes. Model identities accompany the numerical results}{figure.1}{}}
