\@writefile{lot}{\contentsline {table}{\numberline {S2}{\ignorespaces \textbf  {Legacy grouped control, kept distinct from canonical pathways.} Values represent the mean $\pm $ sample standard deviation across three independent training seeds (except for the single MPA0 checkpoint). G1 is a 61-atom, five-image reference with a QE forward peak of 0.336~eV. The final column reports diagnostic fixed-image discrepancies rather than dynamic physical barriers. The current pointwise release in Table~\ref {tab:current_pointwise} supplies freshly recomputed static metrics, which replace legacy rounded values to maintain a consistent independent G1 control.}}{4}{table.2}\protected@file@percent }
\newlabel{tab:a2_grouped_audit_summary}{{S2}{4}{\textbf {Legacy grouped control, kept distinct from canonical pathways.} Values represent the mean $\pm $ sample standard deviation across three independent training seeds (except for the single MPA0 checkpoint). G1 is a 61-atom, five-image reference with a QE forward peak of 0.336~eV. The final column reports diagnostic fixed-image discrepancies rather than dynamic physical barriers. The current pointwise release in Table~\ref {tab:current_pointwise} supplies freshly recomputed static metrics, which replace legacy rounded values to maintain a consistent independent G1 control}{table.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S2}{\ignorespaces \textbf  {Legacy grouped retraining and train--path overlap audit.} \textbf  {a,} Absolute fixed-image discrepancies on G1 for FT-600K, Scratch, and Scratch-5\%. The plot reports individual training seed outcomes alongside their mean $\pm $ sample standard deviation. The foundation symbol represents the single zero-shot checkpoint. The dashed 0.16~eV baseline marks the superseded preliminary point estimate. \textbf  {b,} Minimum training-set SOAP and composition-compatible local RMSD distances, normalized by their respective near-duplicate thresholds. Values strictly greater than one confirm the structural separation of the test images from the training distribution. The G1 and 25-image audits function explicitly within the legacy reference collection, remaining methodologically distinct from the 1.5243~eV canonical in-gap benchmark evaluated in the main text.}}{5}{figure.2}\protected@file@percent }
\newlabel{fig:grouped_overlap}{{S2}{5}{\textbf {Legacy grouped retraining and train--path overlap audit.} \textbf {a,} Absolute fixed-image discrepancies on G1 for FT-600K, Scratch, and Scratch-5\%. The plot reports individual training seed outcomes alongside their mean $\pm $ sample standard deviation. The foundation symbol represents the single zero-shot checkpoint. The dashed 0.16~eV baseline marks the superseded preliminary point estimate. \textbf {b,} Minimum training-set SOAP and composition-compatible local RMSD distances, normalized by their respective near-duplicate thresholds. Values strictly greater than one confirm the structural separation of the test images from the training distribution. The G1 and 25-image audits function explicitly within the legacy reference collection, remaining methodologically distinct from the 1.5243~eV canonical in-gap benchmark evaluated in the main text}{figure.2}{}}
