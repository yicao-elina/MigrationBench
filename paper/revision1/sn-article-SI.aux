\@writefile{lot}{\contentsline {table}{\numberline {S3}{\ignorespaces \textbf  {Checkpoint ensemble composition for selected profile visualizations.} Counts indicate the number of distinct model checkpoints evaluated for each pathway class in main Fig.~\ref {M-fig:profiles}a--f. Foundation counts represent distinct zero-shot architectures, whereas scratch and fine-tuned counts represent independent training initializations. For the FT-MultiT condition, the within-QL self-relaxed pathway yields zero stable trajectories under the strict topological criteria. The visualized ensemble explicitly focuses on these core conditions, maintaining geometric consistency separate from the expanded contemporary seed matrix.}}{6}{table.3}\protected@file@percent }
\newlabel{tab:profile_coverage}{{S3}{6}{\textbf {Checkpoint ensemble composition for selected profile visualizations.} Counts indicate the number of distinct model checkpoints evaluated for each pathway class in main Fig.~\ref {M-fig:profiles}a--f. Foundation counts represent distinct zero-shot architectures, whereas scratch and fine-tuned counts represent independent training initializations. For the FT-MultiT condition, the within-QL self-relaxed pathway yields zero stable trajectories under the strict topological criteria. The visualized ensemble explicitly focuses on these core conditions, maintaining geometric consistency separate from the expanded contemporary seed matrix}{table.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S4}{\ignorespaces \textbf  {Canonical fixed-path reference discrepancies.} Absolute energy discrepancies relative to the canonical task peaks (eV). Trained conditions report the mean $\pm $ sample standard deviation across three independent training seeds; foundation entries represent individual zero-shot checkpoints. Statistics are derived from the comprehensive 120-record matrix detailed in Fig.~\ref {M-fig:taskmatrix}b. Migration benchmarks are evaluated directly on the fully relaxed first-principles coordinates. Sliding discrepancies serve as localized scalar metrics, complementing the comprehensive full-profile and endpoint-return structural diagnostics.}}{7}{table.4}\protected@file@percent }
\newlabel{tab:current_neb_errors}{{S4}{7}{\textbf {Canonical fixed-path reference discrepancies.} Absolute energy discrepancies relative to the canonical task peaks (eV). Trained conditions report the mean $\pm $ sample standard deviation across three independent training seeds; foundation entries represent individual zero-shot checkpoints. Statistics are derived from the comprehensive 120-record matrix detailed in Fig.~\ref {M-fig:taskmatrix}b. Migration benchmarks are evaluated directly on the fully relaxed first-principles coordinates. Sliding discrepancies serve as localized scalar metrics, complementing the comprehensive full-profile and endpoint-return structural diagnostics}{table.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S5}{\ignorespaces \textbf  {Legacy QE pathway references.} Forward and reverse peak values are evaluated explicitly relative to their respective endpoints. These first-principles pathway calculations establish rigorous physical baselines, maintaining clear methodological separation from the subsequent model-relaxed trajectories. This legacy collection remains structurally distinct from the canonical main-figure reference set.}}{7}{table.5}\protected@file@percent }
\newlabel{tab:dft_neb_barriers_revised}{{S5}{7}{\textbf {Legacy QE pathway references.} Forward and reverse peak values are evaluated explicitly relative to their respective endpoints. These first-principles pathway calculations establish rigorous physical baselines, maintaining clear methodological separation from the subsequent model-relaxed trajectories. This legacy collection remains structurally distinct from the canonical main-figure reference set}{table.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S6}{\ignorespaces \textbf  {Legacy migration pathway registry.} Class- and geometry-based nomenclatures directly map the archived pathway controls to their published release identifiers. This explicit taxonomy maintains clear geometric separation between the five-image G/Q baseline references and the ten-image canonical pathways evaluated in the primary text.}}{8}{table.6}\protected@file@percent }
\newlabel{tab:path_registry}{{S6}{8}{\textbf {Legacy migration pathway registry.} Class- and geometry-based nomenclatures directly map the archived pathway controls to their published release identifiers. This explicit taxonomy maintains clear geometric separation between the five-image G/Q baseline references and the ten-image canonical pathways evaluated in the primary text}{table.6}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {2.3}Additional dopant responses}{8}{subsection.2.3}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {S7}{\ignorespaces \textbf  {Path-resolved fixed-path errors for the grouped models.} Absolute errors (eV), mean $\pm $ sample standard deviation across three independent training initializations for FT-600K, Scratch-5\%, and full Scratch. The QE reference column gives the forward energy reference of each image set. Q1--Q3 are UNCONVERGED paths; their entries are image-set energy spans used for fixed-path comparison, not physical migration barriers. Errors are fixed-path errors on identical images, reported per path and not pooled across classes. Path names are defined in Table~\ref {tab:path_registry}.}}{9}{table.7}\protected@file@percent }
\newlabel{tab:scratch5_path_resolved_descriptive}{{S7}{9}{\textbf {Path-resolved fixed-path errors for the grouped models.} Absolute errors (eV), mean $\pm $ sample standard deviation across three independent training initializations for FT-600K, Scratch-5\%, and full Scratch. The QE reference column gives the forward energy reference of each image set. Q1--Q3 are UNCONVERGED paths; their entries are image-set energy spans used for fixed-path comparison, not physical migration barriers. Errors are fixed-path errors on identical images, reported per path and not pooled across classes. Path names are defined in Table~\ref {tab:path_registry}}{table.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S3}{\ignorespaces \textbf  {Canonical foundation-model pathway responses for four dopants in \ce {Sb2Te3}.} Rows detail migration pathways for Cr (\textbf  {a--c}), Cu (\textbf  {d--f}), Li (\textbf  {g--i}), and Na (\textbf  {j--l}); columns map in-gap, gap-to-QL, and within-QL configurations. Curves evaluate the MACE-MP, MACE-OMAT-0, and MACE-MH checkpoint groups against the established first-principles baselines (dashed lines). Energies are referenced to the initial image, with the horizontal coordinate representing the normalized reaction coordinate. Shaded bands quantify the aggregate variance across available model checkpoints. These first-principles benchmarks establish exact physical energy landscapes, evaluating base-model structural fidelity across diverse local chemical domains.}}{10}{figure.3}\protected@file@percent }
\newlabel{fig:other_dopants}{{S3}{10}{\textbf {Canonical foundation-model pathway responses for four dopants in \ce {Sb2Te3}.} Rows detail migration pathways for Cr (\textbf {a--c}), Cu (\textbf {d--f}), Li (\textbf {g--i}), and Na (\textbf {j--l}); columns map in-gap, gap-to-QL, and within-QL configurations. Curves evaluate the MACE-MP, MACE-OMAT-0, and MACE-MH checkpoint groups against the established first-principles baselines (dashed lines). Energies are referenced to the initial image, with the horizontal coordinate representing the normalized reaction coordinate. Shaded bands quantify the aggregate variance across available model checkpoints. These first-principles benchmarks establish exact physical energy landscapes, evaluating base-model structural fidelity across diverse local chemical domains}{figure.3}{}}
\@writefile{toc}{\contentsline {section}{\numberline {3}Collective sliding}{10}{section.3}\protected@file@percent }
\newlabel{sec:sliding}{{3}{10}{Collective sliding}{section.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S4}{\ignorespaces \textbf  {Macroscopic sliding profiles across foundation, fine-tuned, and scratch routes.} \textbf  {a,b,} Fixed-path relative energies for pristine and Cr-in-gap \ce {Sb2Te3}, respectively. \textbf  {c,d,} Endpoint-initialized, model-relaxed dynamic profiles for the corresponding systems. Solid coloured distributions distinguish the evaluated training conditions and their intra-route initialization variance; the dashed dark curve represents the canonical first-principles reference. The normalized coordinate maps the progression of the structural phase space. First-principles reference peaks establish absolute macroscopic sliding barriers of 1.6538~eV (pristine) and 2.5708~eV (Cr-in-gap). This evaluation framework rigorously decouples static peak calibration, global profile curvature, and thermodynamic endpoint-return fidelity, directly benchmarking the intrinsic dynamic optimization capabilities of the respective neural potentials.}}{11}{figure.4}\protected@file@percent }
\newlabel{fig:sliding_all}{{S4}{11}{\textbf {Macroscopic sliding profiles across foundation, fine-tuned, and scratch routes.} \textbf {a,b,} Fixed-path relative energies for pristine and Cr-in-gap \ce {Sb2Te3}, respectively. \textbf {c,d,} Endpoint-initialized, model-relaxed dynamic profiles for the corresponding systems. Solid coloured distributions distinguish the evaluated training conditions and their intra-route initialization variance; the dashed dark curve represents the canonical first-principles reference. The normalized coordinate maps the progression of the structural phase space. First-principles reference peaks establish absolute macroscopic sliding barriers of 1.6538~eV (pristine) and 2.5708~eV (Cr-in-gap). This evaluation framework rigorously decouples static peak calibration, global profile curvature, and thermodynamic endpoint-return fidelity, directly benchmarking the intrinsic dynamic optimization capabilities of the respective neural potentials}{figure.4}{}}
