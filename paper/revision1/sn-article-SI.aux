\@writefile{lot}{\contentsline {table}{\numberline {S10}{\ignorespaces \textbf  {Algorithmic $t$-SNE sensitivity metrics.} Scores utilize the 15 model labels. Trustworthiness is evaluated using five neighbors, comparing each projection directly against the unprojected input matrix. These metrics explicitly quantify the topological stability of the dimensionality reduction.}}{14}{table.10}\protected@file@percent }
\newlabel{tab:current_tsne_sensitivity}{{S10}{14}{\textbf {Algorithmic $t$-SNE sensitivity metrics.} Scores utilize the 15 model labels. Trustworthiness is evaluated using five neighbors, comparing each projection directly against the unprojected input matrix. These metrics explicitly quantify the topological stability of the dimensionality reduction}{table.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S5}{\ignorespaces \textbf  {Scale and projection metrics for the explicit feature dataset.} \textbf  {a,} Silhouette scores before projection for raw output features, standardized output features, and the invariant neighbor histogram. \textbf  {b,} $t$-SNE silhouette values across distinct perplexities and algorithm initializations. Original-space values and per-run settings are detailed in Tables~\ref {tab:current_original_space} and \ref {tab:current_tsne_sensitivity}. The raw output-space score is 0.063 (standardized: $-0.059$), while the common histogram score is 0.056. These quantitative bounds establish the projection as a descriptive population diagnostic.}}{14}{figure.5}\protected@file@percent }
\newlabel{fig:current_feature_audit}{{S5}{14}{\textbf {Scale and projection metrics for the explicit feature dataset.} \textbf {a,} Silhouette scores before projection for raw output features, standardized output features, and the invariant neighbor histogram. \textbf {b,} $t$-SNE silhouette values across distinct perplexities and algorithm initializations. Original-space values and per-run settings are detailed in Tables~\ref {tab:current_original_space} and \ref {tab:current_tsne_sensitivity}. The raw output-space score is 0.063 (standardized: $-0.059$), while the common histogram score is 0.056. These quantitative bounds establish the projection as a descriptive population diagnostic}{figure.5}{}}
