&CONTROL
  calculation = 'relax'
  restart_mode = 'from_scratch'
  prefix = 'endpoint'
  tprnfor = .true.
  max_seconds = 100
/
&SYSTEM
  nat = 2
  ntyp = 2
  ecutwfc = 50
  ecutrho = 200
  occupations = 'smearing'
  smearing = 'gaussian'
  degauss = 0.005
/
&ELECTRONS
  conv_thr = 1.0d-6
/
ATOMIC_SPECIES
Cr 1 Cr.UPF
Te 1 Te.UPF
ATOMIC_POSITIONS angstrom
Cr 0 0 0
Te 2.1 0 0
K_POINTS gamma
CELL_PARAMETERS angstrom
10 0 0
0 10 0
0 0 10
