+class EnhancedErrorPredictor:
+    """Enhanced ML model for predicting and analyzing prediction errors"""
+
+    def __init__(self, dataset, target_type='error', feature_names=None):
+        self.target_type = target_type
+        self.feature_names = feature_names or []
+
+        # Use more sophisticated model
+        self.model = GradientBoostingRegressor(
+            n_estimators=200, learning_rate=0.05, max_depth=8,
+            subsample=0.8, random_state=42
+        )
+
+        X = dataset['features']
+
+        if target_type == 'error':
+            y = np.abs(dataset['prediction_errors'])
+        elif target_type == 'signed_error':
+            y = dataset['prediction_errors']  # Keep sign for bias analysis
+        else:
+            y = dataset['ground_truth_energies']
+
+        # Remove invalid data
+        valid_mask = ~(np.isnan(X).any(axis=1) | np.isnan(y) | np.isinf(y))
+        X, y = X[valid_mask], y[valid_mask]
+
+        if len(X) == 0:
+            raise ValueError("No valid training data")
+
+        # Train model
+        self.model.fit(X, y)
+
+        # Performance metrics
+        y_pred = self.model.predict(X)
+        mae = mean_absolute_error(y, y_pred)
+        r2 = r2_score(y, y_pred)
+
+        print(f"    {target_type.title()} predictor - MAE: {mae:.6f}, R²: {r2:.4f}")
+
+        # Store training data for analysis
+        self.X_train = X
+        self.y_train = y
+
+def perform_direct_shap_analysis(datasets):
+    """Perform SHAP analysis on raw SOAP features"""
+
+    print("\nPerforming direct SOAP SHAP analysis...")
+
+    shap_results = {}
+
+    for model_name, dataset in datasets.items():
+        print(f"\n--- Analyzing {model_name} ---")
+
+        try:
+            # Create predictors
+            error_predictor = EnhancedErrorPredictor(
+                dataset, target_type='error', feature_names=dataset['feature_names']
+            )
+            signed_error_predictor = EnhancedErrorPredictor(
+                dataset, target_type='signed_error', feature_names=dataset['feature_names']
+            )
+
+            # Prepare data for SHAP (use more samples since we're not using PCA)
+            X = dataset['features']
+            if np.any(np.isnan(X)):
+                X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
+
+            # Use more samples for better SHAP analysis
+            max_samples = min(500, len(X))
+            sample_indices = np.random.choice(len(X), max_samples, replace=False)
+            X_sample = X[sample_indices]
+
+            print(f"  > Computing SHAP values for {max_samples} samples...")
+
+            # SHAP analysis for absolute error
+            error_explainer = shap.TreeExplainer(error_predictor.model)
+            error_shap_values = error_explainer(X_sample)
+
+            # SHAP analysis for signed error (bias analysis)
+            signed_error_explainer = shap.TreeExplainer(signed_error_predictor.model)
+            signed_error_shap_values = signed_error_explainer(X_sample)
+
+            # Store results
+            shap_results[model_name] = {
+                'dataset': dataset,
+                'error_predictor': error_predictor,
+                'signed_error_predictor': signed_error_predictor,
+                'error_shap_values': error_shap_values,
+                'signed_error_shap_values': signed_error_shap_values,
+                'X_sample': X_sample,
+                'sample_indices': sample_indices,
+                'feature_names': dataset['feature_names'],
+                'n_soap_features': dataset['n_soap_features'],
+                'soap_interpreter': dataset.get('soap_interpreter')
+            }
+
+            print(f"  > ✓ Completed SHAP analysis for {model_name}")
+
+        except Exception as e:
+            print(f"  > ✗ SHAP analysis failed for {model_name}: {e}")
+            traceback.print_exc()
+
+    return shap_results
