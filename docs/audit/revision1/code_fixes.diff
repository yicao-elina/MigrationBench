+        else:
+            feature_names.extend([f'soap_{i}' for i in range(n_soap_features)])
+
+        # Structural feature names
+        structural_names = [
+            'n_atoms', 'volume', 'volume_per_atom',
+            'cell_a', 'cell_b', 'cell_c', 'angle_alpha', 'angle_beta', 'angle_gamma',
+            'coord_mean', 'coord_std', 'dist_mean', 'dist_std', 'min_dist',
+            'cr_fraction', 'sb_fraction', 'te_fraction'
