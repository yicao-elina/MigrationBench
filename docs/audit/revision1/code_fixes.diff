+    def _create_temp_isolated_xyz(self, atom_energies: Dict[str, float]) -> str:
+        """Create temporary XYZ file with isolated atoms."""
+        from ase import Atoms
+        from ase.io import write
+        
+        # Create temporary file
+        temp_fd, temp_xyz_file = tempfile.mkstemp(suffix='.xyz', prefix='isolated_atoms_')
+        os.close(temp_fd)
+        
+        isolated_atoms = []
+        for element, energy in atom_energies.items():
+            # Create isolated atom at origin with large cell
+            atoms = Atoms(element, positions=[[0.0, 0.0, 0.0]])
+            atoms.set_cell([10.0, 10.0, 10.0])  # Large cell to avoid interactions
+            atoms.set_pbc(True)
+            atoms.info['energy'] = energy  # Store energy in info
+            isolated_atoms.append(atoms)
+        
+        # Write to temporary file
+        write(temp_xyz_file, isolated_atoms)
+        print(f"Created temporary isolated atoms file: {temp_xyz_file}")
+        
+        return temp_xyz_file
