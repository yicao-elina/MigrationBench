+    def load_from_xyz_file(self, xyz_file: str, models: Dict[str, str], batch_size: int = 1) -> None:
+        """Load isolated atom energies from XYZ file for both ground truth and predictions."""
+        print(f"Loading isolated atom energies from: {xyz_file}")
+        
+        try:
+            isolated_atoms = read(xyz_file, index=":")
+            print(f"Found {len(isolated_atoms)} isolated atom configurations")
+        except Exception as e:
+            raise ValueError(f"Error reading isolated atoms file: {e}")
+        
+        # Extract ground truth energies
+        ground_truth_energies = extract_ground_truth_energies(xyz_file)
+        
+        for i, atoms in enumerate(isolated_atoms):
+            if len(atoms) != 1:
+                print(f"Warning: Configuration {i} has {len(atoms)} atoms, expected 1. Skipping.")
+                continue
+            
+            element = atoms.get_chemical_symbols()[0]
+            gt_energy = ground_truth_energies.get(i, float('nan'))
+            
+            if not np.isnan(gt_energy):
+                if element in self.ground_truth_energies:
+                    print(f"Warning: Multiple energies found for {element}, using average")
+                    self.ground_truth_energies[element] = (self.ground_truth_energies[element] + gt_energy) / 2
+                else:
+                    self.ground_truth_energies[element] = gt_energy
+                print(f"Ground truth energy for {element}: {gt_energy:.6f} eV")
+        
+        # CRITICAL FIX: Use the robust prediction pipeline for isolated atoms
+        print("\nPredicting isolated atom energies using robust pipeline...")
+        self._predict_isolated_energies_robust(xyz_file, models, batch_size)
