+    def _predict_isolated_energies_robust(self, xyz_file: str, models: Dict[str, str], batch_size: int) -> None:
+        """
+        CRITICAL FIX: Use the existing robust prediction pipeline for isolated atoms.
+        This reuses the exact same code that works for the main structures.
+        """
+        print("Using robust prediction pipeline for isolated atom energies...")
+        
+        # Temporarily store the original MODEL_PATHS
+        original_models = MODEL_PATHS.copy()
+        
+        try:
+            # Use a minimal subset approach - predict one model at a time to avoid memory issues
+            for model_name, model_path in models.items():
+                print(f"\nPredicting isolated atoms with {model_name}...")
+                
+                # Create single-model dict for prediction
+                single_model_dict = {model_name: model_path}
+                
+                # Call the robust prediction function with isolated atoms
+                isolated_results = self._run_single_model_prediction(xyz_file, single_model_dict, batch_size)
+                
+                # Extract predicted energies from results
+                if isolated_results is not None and len(isolated_results) > 0:
+                    # Load the isolated atoms to get element mapping
+                    try:
+                        isolated_atoms = read(xyz_file, index=":")
+                        
+                        for result in isolated_results:
+                            if result['model_name'] == model_name:
+                                image_idx = result['image_index']
+                                predicted_energy = result['predicted_energy_eV']
+                                
+                                if image_idx < len(isolated_atoms) and not np.isnan(predicted_energy):
+                                    atoms = isolated_atoms[image_idx]
+                                    if len(atoms) == 1:  # Ensure it's a single atom
+                                        element = atoms.get_chemical_symbols()[0]
+                                        self.predicted_energies[model_name][element] = predicted_energy
+                                        print(f"  {element}: {predicted_energy:.6f} eV")
+                    
+                    except Exception as e:
+                        print(f"  Error processing results for {model_name}: {e}")
+                        # Set NaN for all elements for this model
+                        for element in self.ground_truth_energies.keys():
+                            self.predicted_energies[model_name][element] = float('nan')
+                else:
+                    print(f"  No valid results for {model_name}")
+                    # Set NaN for all elements for this model
+                    for element in self.ground_truth_energies.keys():
+                        self.predicted_energies[model_name][element] = float('nan')
+        
+        except Exception as e:
+            print(f"Error in robust isolated atom prediction: {e}")
+            # Set NaN for all models and elements
+            for model_name in models.keys():
+                for element in self.ground_truth_energies.keys():
+                    self.predicted_energies[model_name][element] = float('nan')
