@@ -9,8 +9,76 @@ import numpy as np
 import os
 import argparse
 import sys
+from collections import defaultdict
 from pathlib import Path
 
+# Frame-info keys that identify the originating trajectory/NEB path, checked in order.
+GROUP_TAG_KEYS = ('path_name', 'trajectory', 'group')
+
+def get_group_ids(atoms_list, input_file):
+    """
+    Assign a group ID to every frame.
+
+    Frames sharing a group tag (e.g. 'path_name' from NEB collector output)
+    must end up in the same partition so near-identical images from one
+    trajectory never leak across train/valid/test. When no tag is present,
+    fall back to per-file grouping (all frames of one file = one group).
+    """
+    group_ids = []
+    for atoms in atoms_list:
+        tag = None
+        for key in GROUP_TAG_KEYS:
+            if key in atoms.info:
+                tag = f"{key}={atoms.info[key]}"
+                break
+        if tag is None:
+            tag = f"file={os.path.basename(input_file)}"
+        group_ids.append(tag)
+    return group_ids
+
+def split_groups(group_ids, total_frames, train_ratio, valid_ratio, test_ratio):
+    """
+    Partition group IDs into train/valid/test, keeping every group intact.
+
+    Groups are shuffled (seeded by caller) and greedily assigned to the
+    partition with the largest remaining frame deficit, approximating the
+    requested ratios at group granularity.
+    Returns (train_indices, valid_indices, test_indices).
+    """
+    group_to_indices = defaultdict(list)
+    for idx, gid in enumerate(group_ids):
+        group_to_indices[gid].append(idx)
+
+    unique_groups = list(group_to_indices.keys())
+    np.random.shuffle(unique_groups)
+
+    targets = {
+        'train': train_ratio * total_frames,
+        'valid': valid_ratio * total_frames,
+        'test': test_ratio * total_frames,
+    }
+    counts = {'train': 0, 'valid': 0, 'test': 0}
+    assignment = {'train': [], 'valid': [], 'test': []}
+
+    # Assign largest groups first for better ratio approximation.
+    unique_groups.sort(key=lambda g: -len(group_to_indices[g]))
+    for gid in unique_groups:
+        size = len(group_to_indices[gid])
+        deficits = {name: targets[name] - counts[name] for name in targets}
+        target_name = max(deficits, key=deficits.get)
+        assignment[target_name].extend(group_to_indices[gid])
+        counts[target_name] += size
+
+    # Every group must belong to exactly one partition.
+    train_groups = {group_ids[i] for i in assignment['train']}
+    valid_groups = {group_ids[i] for i in assignment['valid']}
+    test_groups = {group_ids[i] for i in assignment['test']}
+    assert not (train_groups & valid_groups), "Group leak between train and valid"
+    assert not (train_groups & test_groups), "Group leak between train and test"
+    assert not (valid_groups & test_groups), "Group leak between valid and test"
+
+    return assignment['train'], assignment['valid'], assignment['test']
+
