+class SOAPFeatureInterpreter:
+    """Enhanced SOAP feature interpreter with physical meaning"""
+
+    def __init__(self, species, n_max, l_max, r_cut, actual_n_features=None):
+        self.species = sorted(species)
+        self.n_max = n_max
+        self.l_max = l_max
+        self.r_cut = r_cut
+        self.actual_n_features = actual_n_features
+        self.feature_info = self._generate_feature_info()
+
+    def _generate_feature_info(self):
+        """Generate detailed physical information for each SOAP feature"""
+        feature_info = []
+        feature_idx = 0
+
+        # SOAP features are organized by species pairs and (n1, n2, l) combinations
+        for i, species1 in enumerate(self.species):
+            for j, species2 in enumerate(self.species):
+                if i <= j:  # Only upper triangle due to symmetry
+                    for n1 in range(1, self.n_max + 1):
+                        for n2 in range(1, self.n_max + 1):
+                            for l in range(self.l_max + 1):
+                                # Stop if we exceed actual number of features
+                                if self.actual_n_features and feature_idx >= self.actual_n_features:
+                                    return feature_info
+
+                                # Physical interpretation
+                                interaction_type = f"{species1}-{species2}"
+                                if species1 == species2:
+                                    interaction_nature = "homo"
+                                else:
+                                    interaction_nature = "hetero"
+
+                                # Angular character
+                                if l == 0:
+                                    angular_char = "spherical"
+                                elif l == 1:
+                                    angular_char = "dipolar"
+                                elif l == 2:
+                                    angular_char = "quadrupolar"
+                                else:
+                                    angular_char = f"l{l}_multipolar"
+
+                                # Distance scale
+                                avg_n = (n1 + n2) / 2
+                                if avg_n <= 2:
+                                    distance_scale = "short_range"
+                                elif avg_n <= 3:
+                                    distance_scale = "medium_range"
+                                else:
+                                    distance_scale = "long_range"
+
+                                # Create comprehensive label
+                                short_label = f"{interaction_type}_n{n1}{n2}_l{l}"
+                                full_label = f"{interaction_type}_{angular_char}_{distance_scale}_n{n1}{n2}_l{l}"
+
+                                feature_info.append({
+                                    'index': feature_idx,
+                                    'short_label': short_label,
+                                    'full_label': full_label,
+                                    'species_pair': (species1, species2),
+                                    'interaction_nature': interaction_nature,
+                                    'n1': n1, 'n2': n2, 'l': l,
+                                    'angular_character': angular_char,
+                                    'distance_scale': distance_scale,
+                                    'radial_complexity': avg_n,
+                                    'angular_complexity': l
+                                })
+                                feature_idx += 1
+
+        return feature_info
+
+    def get_feature_categories(self):
+        """Get features grouped by physical categories"""
+        categories = {
+            'short_range_spherical': [],
+            'short_range_angular': [],
+            'medium_range_spherical': [],
+            'medium_range_angular': [],
+            'long_range_spherical': [],
+            'long_range_angular': [],
+            'homo_interactions': [],
+            'hetero_interactions': []
+        }
+
+        for info in self.feature_info:
+            idx = info['index']
+
+            # Only include indices that are within bounds
+            if self.actual_n_features and idx >= self.actual_n_features:
+                continue
+
+            # Distance and angular categories
+            if info['distance_scale'] == 'short_range':
+                if info['l'] == 0:
+                    categories['short_range_spherical'].append(idx)
+                else:
+                    categories['short_range_angular'].append(idx)
+            elif info['distance_scale'] == 'medium_range':
+                if info['l'] == 0:
+                    categories['medium_range_spherical'].append(idx)
+                else:
+                    categories['medium_range_angular'].append(idx)
+            else:  # long_range
+                if info['l'] == 0:
+                    categories['long_range_spherical'].append(idx)
+                else:
+                    categories['long_range_angular'].append(idx)
+
+            # Interaction nature
+            if info['interaction_nature'] == 'homo':
+                categories['homo_interactions'].append(idx)
+            else:
+                categories['hetero_interactions'].append(idx)
+
+        return categories
