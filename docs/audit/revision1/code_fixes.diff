+    def calculate_binding_energy(self, atoms, total_energy: float, model_name: str = None) -> Tuple[float, float]:
+        """
+        Calculate binding energy for a structure.
+        
+        Returns:
+            Tuple of (ground_truth_binding_energy, predicted_binding_energy)
+        """
+        composition = Counter(atoms.get_chemical_symbols())
+        
+        # Calculate ground truth binding energy
+        gt_isolated_sum = sum(
+            count * self.ground_truth_energies.get(element, float('nan'))
+            for element, count in composition.items()
+        )
+        gt_binding_energy = total_energy - gt_isolated_sum if not np.isnan(gt_isolated_sum) else float('nan')
+        
+        # Calculate predicted binding energy
+        if model_name and model_name in self.predicted_energies:
+            pred_isolated_sum = sum(
+                count * self.predicted_energies[model_name].get(element, float('nan'))
+                for element, count in composition.items()
+            )
+            pred_binding_energy = total_energy - pred_isolated_sum if not np.isnan(pred_isolated_sum) else float('nan')
+        else:
+            pred_binding_energy = float('nan')
+        
+        return gt_binding_energy, pred_binding_energy
+    
+    def get_summary(self) -> str:
+        """Get summary of loaded isolated atom energies."""
+        summary = "\n--- Isolated Atom Energy Summary ---\n"
+        summary += "Ground Truth Energies:\n"
+        for element, energy in sorted(self.ground_truth_energies.items()):
+            summary += f"  {element}: {energy:.6f} eV\n"
+        
+        summary += "\nPredicted Energies by Model:\n"
+        for model_name, energies in self.predicted_energies.items():
+            summary += f"  {model_name}:\n"
+            for element, energy in sorted(energies.items()):
+                if not np.isnan(energy):
+                    summary += f"    {element}: {energy:.6f} eV\n"
+                else:
+                    summary += f"    {element}: Failed to predict\n"
+        
+        return summary
