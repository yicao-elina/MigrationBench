+def analyze_and_plot_top_features(shap_results, output_dir):
+    """Analyze and plot top 50 features, separating analysis from plotting."""
+    print("Analyzing top-50 features...")
+    all_importance_data = []
+    models = list(shap_results.keys())
+    
+    for model_name in models:
+        result = shap_results.get(model_name)
+        if not result: continue
+        
+        error_importance = np.mean(np.abs(result['error_shap_values'].values), axis=0)
+        all_importance_data.append({'model': model_name, 'error_importance': error_importance})
+        
+    if not all_importance_data:
+        print("No data for top feature analysis.")
+        return [], []
+        
+    feature_names = shap_results[models[0]]['feature_names']
+    n_soap_features = shap_results[models[0]]['n_soap_features']
+    soap_feature_names = feature_names[:n_soap_features]
+    
+    avg_importance = np.mean([d['error_importance'][:n_soap_features] for d in all_importance_data], axis=0)
+    top_50_indices = np.argsort(avg_importance)[-50:]
+    top_50_features = [soap_feature_names[i] for i in top_50_indices]
+    
+    importance_matrix = np.array([d['error_importance'][top_50_indices] for d in all_importance_data])
+    
+    # Find best model for difference plot
+    model_errors = [np.mean(np.abs(shap_results[m]['dataset']['prediction_errors'])) for m in models]
+    best_model_idx = np.argmin(model_errors)
+    best_model_name = models[best_model_idx]
+    difference_matrix = importance_matrix - importance_matrix[best_model_idx]
+
+    # Call plotting functions
+    plot_top50_heatmap(importance_matrix, top_50_features, models, output_dir)
+    plot_top50_difference_heatmap(difference_matrix, top_50_features, models, best_model_name, output_dir)
+
+    # Save ranking data
+    ranking_data = [{'rank': i + 1, 'feature_name': soap_feature_names[idx], 'avg_importance': avg_importance[idx],
+                     **{f'{d["model"]}_importance': d['error_importance'][idx] for d in all_importance_data}}
+                    for i, idx in enumerate(reversed(top_50_indices))]
+    pd.DataFrame(ranking_data).to_csv(os.path.join(output_dir, 'top50_feature_ranking.csv'), index=False)
+    
+    return top_50_indices, top_50_features
