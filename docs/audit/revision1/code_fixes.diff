+    def _run_single_model_prediction(self, xyz_file: str, single_model_dict: Dict[str, str], batch_size: int) -> List[Dict]:
+        """
+        Run prediction for a single model using the robust pipeline.
+        This is a simplified version of predict_energies_with_binding_analysis.
+        """
+        os.environ['PYTORCH_CUDA_ALLOC_CONF'] = 'expandable_segments:True'
+        
+        device = tools.torch_tools.init_device("cuda" if torch.cuda.is_available() else "cpu")
+        tools.torch_tools.set_default_dtype("float64")
+        
+        results_list = []
+        
+        try:
+            # Load images
+            images = read(xyz_file, index=":")
+            ground_truth_energies = extract_ground_truth_energies(xyz_file)
+            
+            # Process the single model
+            for model_name, model_path_str in single_model_dict.items():
+                clear_memory()
+                model_path = Path(model_path_str)
+                
+                try:
+                    # Load model (same as main prediction)
+                    if model_path.suffix == ".pt":
+                        checkpoint = torch.load(model_path, map_location=device, weights_only=False)
+                        model = checkpoint.get('model', checkpoint)
+                    else:
+                        model = torch.load(model_path, map_location=device, weights_only=False)
+                    
+                    model.to(device)
+                    model.eval()
+                    
+                    for param in model.parameters():
+                        param.requires_grad = False
+                    
+                    # Prepare data (same as main prediction)
+                    z_table = utils.AtomicNumberTable([int(z) for z in model.atomic_numbers])
+                    configs = [data.config_from_atoms(atoms) for atoms in images]
+                    
+                    atomic_data_list = [
+                        data.AtomicData.from_config(config, z_table=z_table, cutoff=float(model.r_max))
+                        for config in configs
+                    ]
+                    
+                    data_loader = torch_geometric.dataloader.DataLoader(
+                        dataset=atomic_data_list,
+                        batch_size=min(batch_size, len(images)),  # Use smaller batch for isolated atoms
+                        shuffle=False,
+                        drop_last=False,
+                    )
+                    
+                    all_energies = []
+                    
+                    # Run inference (same as main prediction)
+                    for batch_idx, batch in enumerate(data_loader):
+                        torch.cuda.empty_cache()
+                        batch = batch.to(device)
+                        
+                        if hasattr(batch, 'positions'):
+                            batch.positions.requires_grad_(True)
+                        
+                        with torch.no_grad():
+                            try:
+                                output = model(batch.to_dict())
+                                batch_energies = tools.torch_tools.to_numpy(output["energy"])
+                                all_energies.extend(batch_energies)
+                            except RuntimeError as e:
+                                if "does not require grad" in str(e):
+                                    batch.positions.requires_grad_(True)
+                                    with torch.enable_grad():
+                                        output = model(batch.to_dict())
+                                        batch_energies = tools.torch_tools.to_numpy(output["energy"])
+                                        all_energies.extend(batch_energies)
+                                else:
+                                    raise e
+                        
+                        batch = batch.to('cpu')
+                        del batch, output
+                        torch.cuda.empty_cache()
+                    
+                    # Store results
+                    for i, pred_energy in enumerate(all_energies):
+                        gt_energy = ground_truth_energies.get(i, float('nan'))
+                        
+                        results_list.append({
+                            "model_name": model_name,
+                            "image_index": i,
+                            "predicted_energy_eV": pred_energy,
+                            "ground_truth_energy_eV": gt_energy,
+                        })
+                
+                except Exception as e:
+                    print(f"Error predicting with {model_name}: {e}")
+                    # Add NaN results for failed model
+                    for i in range(len(images)):
+                        gt_energy = ground_truth_energies.get(i, float('nan'))
+                        results_list.append({
+                            "model_name": model_name,
+                            "image_index": i,
+                            "predicted_energy_eV": float('nan'),
+                            "ground_truth_energy_eV": gt_energy,
+                        })
+                
+                finally:
+                    if 'model' in locals():
+                        del model
+                    clear_memory()
+        
+        except Exception as e:
+            print(f"Error in single model prediction: {e}")
+            return []
+        
+        return results_list
