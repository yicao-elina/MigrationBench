+    ax.set_xticks(np.arange(len(top_50_features)))
+    ax.set_xticklabels(top_50_features, rotation=90, fontsize=8)
+    ax.set_yticks(np.arange(len(models)))
+    ax.set_yticklabels(models)
+    ax.set_title('Top 50 SOAP Feature Importance Across Models (Error Prediction)', fontsize=14, fontweight='bold')
+    
+    cbar = plt.colorbar(im, ax=ax)
+    cbar.set_label('Mean |SHAP Value|', rotation=270, labelpad=20)
