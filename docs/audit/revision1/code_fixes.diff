+def parse_xyz_energy_manual(xyz_file, image_index):
+    """Manually parse energy from extended XYZ file for a specific image."""
+    try:
+        with open(xyz_file, 'r') as f:
+            lines = f.readlines()
+        
+        current_image = 0
+        i = 0
+        
+        while i < len(lines):
+            line = lines[i].strip()
+            if not line:
+                i += 1
+                continue
+                
+            try:
+                n_atoms = int(line)
+                
+                if current_image == image_index:
+                    if i + 1 < len(lines):
+                        comment_line = lines[i + 1].strip()
+                        energy_match = re.search(r'energy=([+-]?[0-9]*\.?[0-9]+(?:[eE][+-]?[0-9]+)?)', comment_line)
+                        if energy_match:
+                            return float(energy_match.group(1))
+                    return float('nan')
+                
+                current_image += 1
+                i += n_atoms + 2
+                
+            except ValueError:
+                i += 1
+                
+        return float('nan')
+        
+    except Exception as e:
+        print(f"Manual parsing error for image {image_index}: {e}")
+        return float('nan')
+
+def extract_ground_truth_energies(xyz_file):
+    """Extract ground truth energies from extended XYZ file."""
+    energies = {}
+    
+    try:
+        images = read(xyz_file, index=":")
+        
+        for i, atoms in enumerate(images):
+            try:
+                if hasattr(atoms, 'calc') and atoms.calc is not None:
+                    energy = atoms.get_potential_energy()
+                    energies[i] = energy
+                elif 'energy' in atoms.info:
+                    energies[i] = atoms.info['energy']
+                else:
+                    energies[i] = parse_xyz_energy_manual(xyz_file, i)
+                    
+            except Exception as e:
+                energies[i] = parse_xyz_energy_manual(xyz_file, i)
+        
+    except Exception as e:
+        print(f"ASE failed: {e}, using manual parsing...")
+        
+        try:
+            images = read(xyz_file, index=":")
+            n_images = len(images)
+        except:
+            with open(xyz_file, 'r') as f:
+                lines = f.readlines()
+            
+            n_images = 0
+            i = 0
+            while i < len(lines):
+                line = lines[i].strip()
+                if line and line.isdigit():
+                    n_atoms = int(line)
+                    n_images += 1
+                    i += n_atoms + 2
+                else:
+                    i += 1
+        
+        for i in range(n_images):
+            energies[i] = parse_xyz_energy_manual(xyz_file, i)
+    
+    return energies
