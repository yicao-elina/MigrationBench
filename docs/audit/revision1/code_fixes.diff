+    def load_from_dict(self, atom_energies: Dict[str, float], models: Dict[str, str], batch_size: int = 1) -> None:
+        """Load isolated atom energies from dictionary and predict with models."""
+        print("Loading isolated atom energies from provided dictionary:")
+        
+        self.ground_truth_energies = atom_energies.copy()
+        for element, energy in atom_energies.items():
+            print(f"Ground truth energy for {element}: {energy:.6f} eV")
+        
+        # Create temporary XYZ file with isolated atoms
+        temp_xyz_file = self._create_temp_isolated_xyz(atom_energies)
+        
+        print(f"\nPredicting isolated atom energies using robust pipeline...")
+        try:
+            self._predict_isolated_energies_robust(temp_xyz_file, models, batch_size)
+        finally:
+            # Clean up temporary file
+            if os.path.exists(temp_xyz_file):
+                os.remove(temp_xyz_file)
