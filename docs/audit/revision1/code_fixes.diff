+    print(f"  Best model: {best_model} (MAE: {model_performance[best_model]:.6f})")
+    print(f"  Worst model: {worst_model} (MAE: {model_performance[worst_model]:.6f})")
+
+    best_result = shap_results[best_model]
+    worst_result = shap_results[worst_model]
+    n_soap = best_result['n_soap_features']
+    feature_names = best_result['feature_names']
+    
+    best_importance = np.mean(np.abs(best_result['error_shap_values'].values), axis=0)
