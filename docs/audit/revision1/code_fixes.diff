+class DirectSOAPAnalyzer:
+    """Main analyzer class for direct SOAP analysis"""
+
+    def __init__(self, xyz_file_path, predictions_csv_path):
+        self.xyz_file_path = xyz_file_path
+        self.predictions_csv_path = predictions_csv_path
+        self.feature_extractor = DirectSOAPFeatureExtractor(
+            cutoff=CUTOFF, soap_nmax=SOAP_NMAX, soap_lmax=SOAP_LMAX, n_bins=N_NEIGHBOR_BINS
+        )
+        self.predictions_df = None
+        self.atoms_list = None
+        self.features = None
+        self.feature_names = None
+        self.n_soap_features = 0
+
+    def load_data(self):
+        """Load predictions and atomic structures"""
+        print("Loading predictions and atomic structures...")
+        self.predictions_df = pd.read_csv(self.predictions_csv_path)
+        print(f"  > Loaded predictions: {len(self.predictions_df)} entries")
+        
+        self.atoms_list = read(self.xyz_file_path, index=":")
+        print(f"  > Loaded atomic structures: {len(self.atoms_list)} frames")
+
+        if len(self.atoms_list) > 2000:
+            print(f"  > Sampling every {FRAME_SAMPLING_RATE} frames...")
+            self.atoms_list = self.atoms_list[::FRAME_SAMPLING_RATE]
+            print(f"  > Using {len(self.atoms_list)} frames")
+
+        self.features, self.n_soap_features = self.feature_extractor.extract_all_features(self.atoms_list)
+        self.feature_names = self.feature_extractor.get_feature_names(self.n_soap_features)
+        
+        print(f"  > Feature matrix shape: {self.features.shape}")
+        print(f"  > SOAP features: {self.n_soap_features}")
+        print(f"  > Total feature names: {len(self.feature_names)}")
+
+    def create_model_datasets(self):
+        """Create datasets for each model"""
+        print("Creating model-specific datasets...")
+        datasets = {}
+        models = self.predictions_df['model_name'].unique()
+
+        for model_name in models:
+            model_data = self.predictions_df[self.predictions_df['model_name'] == model_name].copy()
+            valid_mask = ~(model_data['predicted_energy_eV'].isna() | model_data['ground_truth_energy_eV'].isna())
+            model_data = model_data[valid_mask]
+
+            if len(model_data) == 0:
+                print(f"  > No valid data for {model_name}")
+                continue
+
+            indices = model_data['image_index'].values
+            
+            # This logic needs careful alignment between sampled atoms and prediction data
+            # Assuming prediction CSV indices correspond to the original, unsampled XYZ file
+            original_indices = set(indices)
+            sampled_map = {orig_idx: new_idx for new_idx, orig_idx in enumerate(range(0, len(self.predictions_df['image_index'].unique()), FRAME_SAMPLING_RATE))}
+            
+            # Find which of the model's data points correspond to a sampled frame
+            data_mask = np.isin(indices, list(sampled_map.keys()))
+            if not np.any(data_mask):
+                print(f"  > No data for {model_name} matches the sampled frames.")
+                continue
+
+            model_data_sampled = model_data[data_mask]
+            
+            # Get the new indices into the `self.features` array
+            feature_indices = [sampled_map[i] for i in model_data_sampled['image_index'].values]
+            
+            model_features = self.features[feature_indices]
+            
+            datasets[model_name] = {
+                'features': model_features,
+                'ground_truth_energies': model_data_sampled['ground_truth_energy_eV'].values,
+                'predicted_energies': model_data_sampled['predicted_energy_eV'].values,
+                'prediction_errors': model_data_sampled['total_energy_error_eV'].values,
+                'feature_names': self.feature_names,
+                'n_soap_features': self.n_soap_features,
+                'soap_interpreter': self.feature_extractor.soap_interpreter
+            }
+            print(f"  > {model_name}: {len(model_data_sampled)} valid samples after frame sampling")
+            
+        return datasets
+
+def main():
+    """Main execution function"""
+    if len(sys.argv) != 3:
+        print("Usage: python direct_soap_shap_analysis_JHU.py <xyz_file_path> <predictions_csv_path>")
+        sys.exit(1)
+        
+    xyz_file_path = sys.argv[1]
+    predictions_csv_path = sys.argv[2]
+    
+    if not Path(xyz_file_path).exists() or not Path(predictions_csv_path).exists():
+        print(f"Error: Input file not found.")
+        sys.exit(1)
+        
