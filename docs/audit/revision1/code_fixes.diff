+    
+    # Analysis for plots - now for Top 50
+    top_features_idx = np.argsort(best_importance[:n_soap] + worst_importance[:n_soap])[-50:]
+    importance_diff = worst_importance[:n_soap] - best_importance[:n_soap]
+    top_diff_idx = np.argsort(np.abs(importance_diff))[-50:]
+    best_errors = np.abs(best_result['dataset']['prediction_errors'])
+    worst_errors = np.abs(worst_result['dataset']['prediction_errors'])
+    
+    all_importances = np.array([np.mean(np.abs(shap_results[m]['error_shap_values'].values), axis=0)[:n_soap] for m in models])
