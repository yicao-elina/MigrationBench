+def analyze_and_plot_model_comparison(shap_results, output_dir):
+    """Analyze model failure/success and call individual plotting functions."""
+    print("Creating model failure/success analysis...")
+    models = list(shap_results.keys())
+    if len(models) < 2:
+        print("Need at least 2 models for comparison.")
+        return
+
+    model_performance = {m: np.mean(np.abs(shap_results[m]['dataset']['prediction_errors'])) for m in models}
+    best_model = min(model_performance, key=model_performance.get)
