+class DirectSOAPFeatureExtractor:
+    """Feature extractor that preserves raw SOAP descriptors for direct analysis"""
+
+    def __init__(self, cutoff=5.0, soap_nmax=4, soap_lmax=4, n_bins=30):
+        self.cutoff = cutoff
+        self.soap_nmax = soap_nmax
+        self.soap_lmax = soap_lmax
+        self.n_bins = n_bins
+        self.soap_descriptor = None
+        self.soap_interpreter = None
+        self.scaler = StandardScaler()
+
+    def extract_raw_soap_descriptors(self, atoms_list):
+        """Extract raw SOAP descriptors without PCA"""
+        print("  > Extracting raw SOAP descriptors...")
+        try:
+            species = list(set(atoms_list[0].get_chemical_symbols()))
+            print(f"    Species found: {species}")
+
+            self.soap_descriptor = SOAP(
+                species=species, periodic=True, r_cut=self.cutoff,
+                n_max=self.soap_nmax, l_max=self.soap_lmax, average="inner"
+            )
+
+            soap_features = []
+            for i, atoms in enumerate(atoms_list):
+                try:
+                    soap_vec = self.soap_descriptor.create(atoms)
+                    soap_features.append(soap_vec)
+                except Exception as e:
+                    print(f"    Warning: SOAP failed for frame {i}: {e}")
+                    if len(soap_features) > 0:
+                        soap_features.append(np.zeros_like(soap_features[0]))
+                    else:
+                        # Estimate SOAP vector size
+                        n_species = len(species)
+                        estimated_size = n_species * (n_species + 1) // 2 * (self.soap_nmax ** 2) * (self.soap_lmax + 1)
+                        soap_features.append(np.zeros(estimated_size))
+
+            raw_soap = np.array(soap_features)
+            print(f"    Raw SOAP shape: {raw_soap.shape}")
+
+            # Initialize SOAP interpreter with actual number of features
+            actual_soap_features = raw_soap.shape[1]
+            self.soap_interpreter = SOAPFeatureInterpreter(
+                species, self.soap_nmax, self.soap_lmax, self.cutoff,
+                actual_n_features=actual_soap_features
+            )
+
+            # Standardize features for better SHAP analysis
+            raw_soap_scaled = self.scaler.fit_transform(raw_soap)
+
+            return raw_soap_scaled
+
+        except Exception as e:
+            print(f"    Error in SOAP extraction: {e}")
+            traceback.print_exc()
+            return np.zeros((len(atoms_list), 100))  # Fallback
+
+    def extract_structural_features(self, atoms_list):
+        """Extract basic structural features"""
+        print("  > Extracting structural features...")
+        structural_features = []
+
+        for atoms in atoms_list:
+            features = []
+
+            # Basic properties
+            features.append(len(atoms))
+            features.append(atoms.get_volume())
+            features.append(atoms.get_volume() / len(atoms))  # Volume per atom
+
+            # Cell parameters
+            cell = atoms.get_cell()
+            features.extend(cell.lengths())
+            features.extend(cell.angles())
+
+            # Coordination statistics
+            try:
+                i, j, d = neighbor_list('ijd', atoms, cutoff=self.cutoff)
+                coord_numbers = np.bincount(i, minlength=len(atoms))
+
+                features.extend([
+                    np.mean(coord_numbers), np.std(coord_numbers),
+                    np.mean(d), np.std(d), np.min(d)
+                ])
+
+            except:
+                features.extend([0.0] * 5)
+
+            # Element composition
+            symbols = atoms.get_chemical_symbols()
+            for symbol in ['Cr', 'Sb', 'Te']:
+                features.append(symbols.count(symbol) / len(atoms))
+
+            structural_features.append(features)
+
+        return np.array(structural_features)
+
+    def extract_all_features(self, atoms_list):
+        """Extract all features with raw SOAP descriptors"""
+        print(f"Extracting features from {len(atoms_list)} frames...")
+
+        raw_soap = self.extract_raw_soap_descriptors(atoms_list)
+        structural_features = self.extract_structural_features(atoms_list)
+
+        # Combine features
+        all_features = np.hstack([raw_soap, structural_features])
+
+        print(f"  > Combined feature shape: {all_features.shape}")
+        print(f"  > SOAP features: {raw_soap.shape[1]}")
+        print(f"  > Structural features: {structural_features.shape[1]}")
+
+        return all_features, raw_soap.shape[1]
+
+    def get_feature_names(self, n_soap_features):
+        """Generate feature names"""
+        feature_names = []
+
+        # SOAP feature names
+        if self.soap_interpreter and len(self.soap_interpreter.feature_info) > 0:
+            for info in self.soap_interpreter.feature_info:
