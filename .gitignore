.DS_Store
.venv/
.pytest_cache/
.ruff_cache/
__pycache__/
*.py[cod]
*.egg-info/
.snakemake/
work/

# LaTeX build products
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.run.xml
*.synctex.gz
# Compact scientific/scheduler logs are evidence, not LaTeX build products.
!data/**/*.out
!data/**/*.log
!data/**/*.err
paper/sn-article-final.pdf
paper/sn-article-SI.pdf
paper/response_to_reviewers.pdf
registry/release_audit.ok

# Prohibited heavyweight computational state
**/outdir/
**/*.save/
**/wfc*.dat
**/charge-density.dat
**/*.checkpoint
**/*.model
**/*.pt
**/*.pth

# Runtime locks and scheduler state are not canonical inputs
*.lock
