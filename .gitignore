.DS_Store
.venv/
.pytest_cache/
.ruff_cache/
__pycache__/
*.py[cod]
*.egg-info/
.snakemake/
work/

# LaTeX build products
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.run.xml
*.synctex.gz
# Compact scientific/scheduler logs are evidence, not LaTeX build products.
!data/**/*.out
!data/**/*.log
!data/**/*.err
paper/sn-article-final.pdf
paper/sn-article-SI.pdf
paper/response_to_reviewers.pdf
registry/release_audit.ok

# Skipjack project-local runtime and validation outputs
.python_pkgs/
.python_pkgs
.python_pkgs.*
logs/
env_test2.slurm

# Prohibited heavyweight computational state
**/outdir/
**/*.save/
**/wfc*.dat
**/charge-density.dat
**/*.checkpoint
**/*.model
**/*.pt
**/*.pth

# Runtime locks and scheduler state are not canonical inputs
*.lock

# Raw NEB optimizer trajectories and local scratch (kept on disk / HPC, not in git)
analysis/**/mlff_neb.traj
analysis/**/mlff_neb_*_history.extxyz
**/raw_cache/
*.pov-state
tmp/
*.xdv
*.toc
paper/revision1/figure_book.pdf
paper/revision1/figure_pages.pdf
paper/revision1/sn-article-*.pdf
paper/revision1/response_to_reviewers.pdf
.claude/settings.local.json
reproducibility/canva_palette_vector_bundle_20261105/figures/CANVA-P03_parity_2x4_palette_updated.svg
